;;-*-Lisp-*-
(in-package goal)

(defun progress-allowed? ()
  (if (or (not (-> *setting-control* current allow-progress)) (< (-> *display* base-frame-counter) (-> *game-info* blackout-time)))
    #f #t))

(deftype block-cam (pov-camera) ())

(defstate pov-camera-playing (block-cam)
  :virtual #t
  :code (behavior ()
    (ja-no-eval :group! (ja-group) :frame-num 0.0)
    (loop
      (ja :num! (loop!))
      (suspend))))

(deftype yellow-shot (projectile-yellow) ())

(defmethod projectile-method-28 ((this yellow-shot)) (none))

(defpartgroup group-balloon-water
  :id 3000
  :bounds (static-bspherem 0.0 -20.1132 -0.0935 29.1362)
  :parts ((sp-item 3001 :fade-after (meters 160) :falloff-to (meters 160))))

(defpart 3001
  :init-specs ((:texture (new 'static 'texture-id :index #x18 :page #x2))
    (:num 0.7)
    (:x (meters -0.25) (meters 1.0))
    (:y (meters 0) (meters 0))
    (:z (meters 0.332) (meters -0.665))
    (:scale-x (meters 1.53) (meters 1.02))
    (:scale-y (meters 2.4) (meters 1.6))
    (:r 192.0)
    (:g 192.0)
    (:b 192.0)
    (:a 32.0 16.0)
    (:vel-x (meters 0) (meters 0))
    (:vel-y (meters -0.075) (meters 0))
    (:vel-z (meters 0) (meters 0))
    (:accel-x (meters 0) (meters 0))
    (:accel-y (meters 0) (meters 0))
    (:timer (seconds 1.7594))
    (:flags (bit2))
    (:launchrot-z (degrees 0.26661))
    (:rotate-y (degrees 90.0))))

(defpartgroup plant-explode
  :id 3002
  :duration (seconds 0.017)
  :flags (use-local-clock)
  :bounds (static-bspherem 0 0 0 6)
  :parts ((sp-item 3003)))

(defpart 3003
  :init-specs
  ((:texture (woodchip effects))
   (:num 16.0 16.0)
   (:y (meters 0) (meters 1))
   (:scale-x (meters 0.375) (meters 0.75))
   (:rot-z (degrees 0) (degrees 360))
   (:scale-y (meters 0.375) (meters 0.15))
   (:r 0.0)
   (:g 128.0)
   (:b 0.0)
   (:a 128.0)
   (:vel-y (meters 0.03) (meters 0.055))
   (:rotvel-z (degrees -0.4) (degrees 0.8))
   (:fade-a -0.28444445)
   (:accel-y (meters -0.00033333333) (meters -0.0016666667))
   (:friction 0.94)
   (:timer (seconds 1.5))
   (:flags (bit2 bit3 bit14))
   (:conerot-x (degrees 45) (degrees 60))
   (:conerot-y (degrees 0) (degrees 360))
   (:conerot-radius (meters 0.875) (meters 0.25))))

(defpart 2528
  :init-specs
  ((:texture (citadel-shield effects))
   (:birth-func 'birth-func-set-quat)
   (:num 1.0)
   (:scale-x (meters 0.7) (meters 0.18))
   (:scale-y (meters 2.0))
   (:r 0.0 44.0)
   (:g 0.0 64.0)
   (:b 128.0 32.0)
   (:a 128.0)
   (:timer (seconds 0.017))
   (:flags (bit2 bit3 bit14 left-multiply-quat))))

(defmethod update-led ((obj pc-settings-jak1)) #t)

(defun beam-color ((r float) (g float) (b float))
  (set! (-> *part-id-table* 2528 init-specs 5 initial-valuef) r)
  (set! (-> *part-id-table* 2528 init-specs 6 initial-valuef) g)
  (set! (-> *part-id-table* 2528 init-specs 7 initial-valuef) b)
  (set-vector! (-> *pc-settings* controller-led-color) (/ r 255.0) (/ g 255.0) (/ b 255.0) 1.0)
  (none))

(def-actor tntbarrel :bounds (0 2 0 4))
(def-actor balloon :idle idle-ja :art '(idle-ja) :bounds (0 0.3 0 6.3))
(def-actor fisher :idle idle-more-often-ja :art '(idle-more-often-ja) :bounds (0 -6 0 14))
(define-extern *plat* skeleton-group)
(define-extern *dark-plant* skeleton-group)
(define-extern *citb-sagecage* skeleton-group)
(define-extern *green-sagecage* skeleton-group)
(define-extern *citb-drop-plat* skeleton-group)
(define-extern *citb-drop-plat-yellow-sg* skeleton-group)
(define-extern *citb-drop-plat-red-sg* skeleton-group)
(define-extern *citb-drop-plat-green-sg* skeleton-group)
(define-extern *citb-drop-plat-blue-sg* skeleton-group)

(deftype block-id (structure) ((id int)))

(define *block* (new 'static 'block-id :id 0))
(define *hide* #f)
(define *mode* #f)

(deftype block-fisher (process-drawable) ((base vector :inline)) (:state-methods idle))

(defbehavior block-fisher-init-by-other block-fisher ((plat symbol))
  (set! (-> self root) (new 'process 'trsqv))
  (if plat (set! (-> self part) (create-launch-control (-> *part-group-id-table* 107) self)))
  (initialize-skeleton self (if plat *plat-sg* *fisher-sg*) '())
  (when (not plat)
    (set-vector! (-> self root scale) 1.25 1.25 1.25 1.0)
    (quaternion-set! (-> self root quat) 0.0 -0.57 0.0 0.82))
  (go (method-of-object self idle))
  (none))

(defstate idle (block-fisher)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (msg event-message-block))
    (when (and (not *hint-semaphore*) (= message 'emote) (-> *pc-settings* memcard-00))
      (ambient-hint-spawn (the string (-> msg param 0)) (the-as vector #f) *entity-pool* 'ambient)
      (if (= (ja-frame-num 0) 75.0) (ja-no-eval :group! (-> self draw art-group data 10) :frame-num 0.0))))
  :trans (behavior () (if (not (nonzero? (-> self part))) (spool-push *art-control* "fisher-reminder-1" 0 self -1.0)))
  :code (behavior ()
    (when (not (nonzero? (-> self part)))
      (while (= (-> self draw art-group data 10) #f) (suspend))
      (ja-no-eval :group! (-> self draw art-group data 10) :frame-num 75.0))
    (loop
      (if (or (not (-> *pc-settings* memcard-00)) (= *master-mode* 'progress))
        (logior! (-> self draw status) (draw-status hidden))
        (logclear! (-> self draw status) (draw-status hidden)))
      (vector+! (-> self root trans) (-> self base) (static-vectorm -5.5 -29.5 0.0))
      (+! (-> self root trans y) (* 1024.0 (sin (* 109.0 (the float (mod (- (current-time) (-> self state-time)) 600))))))
      (if (not (nonzero? (-> self part))) (+! (-> self root trans x) (meters 1.4)))
      (if (and (nonzero? (-> self part)) (-> *pc-settings* memcard-00)) (spawn (-> self part) (-> self root trans)))
      (ja :num! (seek! (ja-aframe 75.0 0) 1.0))
      (suspend)))
  :post ja-post)

(deftype block (process-drawable)
  ((root   collide-shape-moving :override)
   (base   vector :inline)
   (offset vector :inline)
   (id     int)
   (seek   float)
   (scale  vector :inline)
   (look   int)
   (dest   vector :inline)
   (rot    quaternion :inline)
   (smush  smush-control :inline)
   (notice symbol)
   (lost   symbol)
   (shift  uint)
   (clock  float)
   (sync   sync-info :inline))
  (:state-methods idle))

(defbehavior block-init-by-other block ((base vector) (x-loc float) (y-loc float) (id int) (look int) (clock float))
  (set! (-> self root) (new 'process 'collide-shape-moving self (collide-list-enum hit-by-player)))
  (set-root-prim! (-> self root) (new 'process 'collide-shape-prim-group (-> self root) (the-as uint 1) 0))
  (vector-copy! (-> self base) base)
  (set-vector! (-> self dest) x-loc y-loc 0.0 1.0)
  (vector-copy! (-> self offset) (-> self dest))
  (set! (-> self id) id)
  (set! (-> self look) look)
  (set! (-> self clock) -100.0)
  (vector-identity! (-> self scale))
  (quaternion-identity! (-> self rot))
  (let ((skel (case look ((0) *crate-darkeco-sg*) ((1) *crate-iron-sg*) ((2) *crate-steel-sg*) ((3) *crate-wood-sg*)
    ((4) *crate-barrel-sg*) ((5) *crate-bucket-sg*) ((6) *tntbarrel-sg*) ((7 8) *dark-plant-sg*)
    ((9) *balloon-sg*) ((10) *citb-drop-plat-sg*) ((11) *citb-drop-plat-red-sg*) ((12) *citb-drop-plat-green-sg*)
    ((13) *citb-drop-plat-blue-sg*) ((14) *citb-drop-plat-yellow-sg*) ((15) *citb-sagecage-sg*) ((16) *green-sagecage-sg*)
    (else (the skeleton-group #f)))))
    (if skel (initialize-skeleton self skel '()) ))
  (case look
    ((5) (set-vector! (-> self scale) 1.55 1.75 1.55 1.0))
    ((6) (set-vector! (-> self scale) 0.43 0.43 0.43 1.0))
    ((7 8) (set-vector! (-> self scale) 0.33 0.33 0.33 1.0)
     (quaternion-set! (-> self rot) 0.65 -0.27 -0.27 0.65)
     (set-vector! (-> self draw color-emissive) 0.05 0.05 0.05 1.0))
    ((9) (set-vector! (-> self scale) 0.4 0.4 0.4 1.0))
    ((10 11 12 13 14) (set-vector! (-> self scale) 0.5 0.5 0.5 1.0)
     (quaternion-set! (-> self rot) 0.7 0.0 0.0 0.7)
     (set! (-> self draw light-index) (the-as uint 1)))
    ((15 16) (set-vector! (-> self scale) 0.5 0.5 0.5 1.0)
     (set! (-> self draw shadow) #f)))
  (let ((part (case look ((7 8) 59) ((9) 3000) ((17) 48) ((18) 56) ((19) 42) ((20) 58) (else 0))))
    (if (!= part 0) (set! (-> self part) (create-launch-control (-> *part-group-id-table* part) self))))
  (if (= look 7) (ja-no-eval :group! dark-plant-idle-ja :frame-num max))
  (when (= look 8)
    (set! (-> self clock) clock)
    (ja-no-eval :group! dark-plant-death-ja :frame-num max))
  (vector-copy! (-> self root scale) (-> self scale))
  (quaternion-copy! (-> self root quat) (-> self rot))
  (load-params! (-> self sync) self (the-as uint 2400) 0.0 0.15 0.15)
  (when (= *mode* 'intro)
    (vector*! (-> self scale) (-> self scale) (static-vector 0.47 0.47 0.47 1.0))
    (if (= look 3) (vector*! (-> self scale) (-> self scale) (static-vector 0.9 0.9 0.9 1.0))))
  (go (method-of-object self idle))
  (none))

(defstate idle (block)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (msg event-message-block))
    (case message
      (('place) (if (<= (-> self look) 6) (activate! (-> self smush) -0.1 75 150 1.0 1.0))
       (if (= (-> self look) 7) (ja-no-eval :group! dark-plant-idle-ja :frame-num (rand-vu-float-range 12.0 18.0))))
      (('break)
       (let ((part 0))
         (set! part (case (-> self look) ((17) 49) ((18) 57) ((19) 43) ((20) 61) ((7 8) 3002) ((9) 227) ((10 11 12 13 14 15 16) 0) (else 72)))
         (if (!= part 0) (process-spawn part-tracker :init part-tracker-init (-> *part-group-id-table* part) -1 #f #f #f
           (-> self root trans) :to *entity-pool*)))
       (case (-> self look)
         ((8) (set! (-> self clock) 0.7)
          (set! (-> self look) 21)
          (logior! (-> self draw status) (draw-status hidden))
          (set! (-> self seek) 0.1)
          (vector-copy! (-> self dest) (static-vectorm 26.7 -3.0 0.0)))
         ((9) ((method-of-type process deactivate) self))
         ((10 11 12 13 14)
          (vector-! (-> self dest) (-> self dest) (static-vectorm 0 200 30))
          (set! (-> self seek) (rand-vu-float-range 0.002 0.0035)))
         ((15) (set! (-> self clock) 0.55)
          (sound-play "sagecage-off" :position #f))
         ((16) (set! (-> self clock) 1.0)
          (ja-no-eval :group! (-> self draw art-group data 6) :frame-num 2.0))
         (else (deactivate self)))
       (set! (-> self id) -100))
      (('lose)
       (set! (-> self lost) #t)
       (+! (-> self dest y) (meters 200))
       (set! (-> self seek) 0.001))
      (('notice) (set! (-> self notice) #t))
      (('spin) (quaternion-rotate-y! (-> self rot) (-> self rot) (degrees (the-as float (-> msg param 0)))))
      (('set-loc)
       (set-vector! (-> self dest) (the-as float (-> msg param 0)) (the-as float (-> msg param 1)) (-> self dest z) 1.0)
       (set! (-> self seek) 0.375))
      (('shoot-left)
       (process-spawn yellow-shot :init projectile-init-by-other (-> self entity) (-> self root trans)
       (static-vectorm -60 0 0) #f #f :to (process-by-name "block-game-1" *active-pool*)))
      (('shoot-right)
       (process-spawn yellow-shot :init projectile-init-by-other (-> self entity) (-> self root trans)
       (static-vectorm 60 0 0) #f #f :to (process-by-name "block-game-1" *active-pool*)))
      (('shift)
       (-! (-> self dest y) (* (-> self shift) (meters 2.0)))
       (set! (-> self seek) (if (= *mode* 'tile) 0.375 (meters 0.6)))
       (set! (-> self shift) 0))
      (('purple)
       (ja-no-eval :group! dark-plant-sprout-ja :frame-num 0.0)
       (set-vector! (-> self draw color-mult) 1.0 1.0 1.0 1.0)
       (set-vector! (-> self draw color-emissive) 0.05 0.05 0.05 1.0)
       (set! (-> self look) 7))
      (('green)
       (cond
         ((and (= (-> self look) 8) (= (the-as float (-> msg param 0)) 0.0))
          (ja-no-eval :group! dark-plant-idle-ja :frame-num 10.5))
         ((= (-> self clock) -100.0)
          (set! (-> self clock) (the-as float (-> msg param 0)))))
       (set! (-> self look) 8))))
  :code (behavior ()
    (loop
      (if (= (-> self look) 16) (spool-push *art-control* "green-sagecage-resolution" 0 self -1.0))
      (if (<= (-> self seek) 1.0)
        (vector-lerp! (-> self offset) (-> self offset) (-> self dest) (* (-> self seek) DISPLAY_FPS_RATIO))
        (vector-seek-3d-smooth! (-> self offset) (-> self dest) (* (-> self seek) DISPLAY_FPS_RATIO) (* 0.78 DISPLAY_FPS_RATIO)))
      (when (= *mode* 'intro)
        (vector-copy! (-> self offset) (-> (the process-drawable (process-by-name "logo" *active-pool*)) node-list data 3 bone position)))
      (vector+! (-> self root trans) (-> self base) (-> self offset))
      (if (or (= (-> self lost) #t) (= *mode* 'intro))
        (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees 60) (seconds-per-frame)))
        (quaternion-slerp! (-> self root quat) (-> self root quat) (-> self rot) (* 0.5 DISPLAY_FPS_RATIO)))
      (when (and (= *mode* 'normal) (nonzero? (-> self draw)))
        (set-vector! (-> self draw color-emissive) 0.0 0.0 0.0 0.0)
        (set! (-> self draw light-index) (the-as uint 0))
        (if (= (-> *time-of-day-proc* 0 time-of-day) 23.0) (set-vector! (-> self draw color-emissive) 0.12 0.12 0.12 0.0))
        (when (or (= (-> (level-get-target-inside *level*) name) 'snow) (= *mode* 'intro))
          (set-vector! (-> self draw color-emissive) 0.15 0.15 0.15 0.0))
        (when (= (-> (level-get-target-inside *level*) name) 'sunken)
          (set! (-> self draw light-index) (the-as uint 1))
          (if (< (get-current-phase (-> self sync)) 0.3)
            (set-vector! (-> self draw color-emissive) 0.0 0.37 0.35 0.0)
            (set-vector! (-> self draw color-emissive) 0.0 0.25 0.52 0.0))))
      (when (and (nonzero? (-> self draw)) (!= *mode* 'menu) (!= (-> self look) 21))
        (if (or (= *master-mode* 'progress) (and *hide* (<= (-> self id) -5)))
          (logior! (-> self draw status) (draw-status hidden))
          (logclear! (-> self draw status) (draw-status hidden))))
      (when (!= (-> self clock) -100.0)
        (set! (-> self clock) (max 0.0 (- (-> self clock) (seconds-per-frame))))
        (case (-> self look) ((10 11 12 13 14)
          (let ((direction (if (= (mod (the int (* (+ (-> self clock) 0.05) 10)) 2) 1) 700 -700)))
            (quaternion-rotate-y! (-> self root quat) (-> self root quat) (* (degrees direction) (seconds-per-frame))))))
        (when (= (-> self clock) 0.0)
          (set! (-> self clock) -100.0)
          (case (-> self look)
            ((7 8) (ja-no-eval :group! dark-plant-sprout-ja :frame-num (if (ja-group? dark-plant-death-ja) 0.0 10.0))
             (set-vector! (-> self draw color-mult) 0.0 10.0 0.0 1.0)
             (set-vector! (-> self draw color-emissive) 0.0 15.0 0.0 1.0))
            ((15) (process-spawn part-tracker :init part-tracker-init (-> *part-group-id-table* 72) -1 #f #f #f
               (-> self root trans) :to *entity-pool*)
             (deactivate self))
            ((16) (+! (-> self dest y) (meters 200)) (set! (-> self seek) 0.002))
            ((21) (deactivate self)))))
      (case (-> self look)
        ((10 11 12 13 14 17 18 19 20) (vector+! (-> self root trans) (-> self root trans) (static-vectorm 0 1 0)))
        ((7 8) (vector+! (-> self root trans) (-> self root trans) (static-vectorm 0 1 -0.5)))
        ((15) (vector+! (-> self root trans) (-> self root trans) (static-vectorm 1 2.4 -0.5)))
        ((16) (vector+! (-> self root trans) (-> self root trans) (static-vectorm -1 2.4 -0.5))))
      (when (not (and (<= (-> self id) -5) (or *hide* (= (-> self look) 9))))
        (when (and (nonzero? (-> self part)) (!= (-> self look) 7) (!= (-> self look) 8))
          (vector-copy! (-> self root root-prim prim-core) (-> self root trans))
          (spawn (-> self part) (the-as vector (-> self root root-prim prim-core))))
        (when (and (= (-> self look) 15) (= (-> self clock) -100))
          (let ((pos (new 'stack-no-clear 'vector))
                (bars (-> (the citb-sagecage (process-by-type citb-sagecage *active-pool*)) bar-array)))
            (dotimes (count 12)
              (vector-matrix*! pos (-> bars count) (-> self node-list data 3 bone transform))
              (launch-particles :system *sp-particle-system-3d* (-> *part-id-table* 2473) pos :rate DISPLAY_FPS_RATIO)))))
      (when (= (-> self notice) #t)
        (when (rand-vu-percent? 0.5)
          (let ((pos (new 'stack-no-clear 'vector)))
            (eco-blue-glow (vector+float! pos (-> self root trans) (rand-vu-float-range -5324.8 5324.8)))))
        (activate! (-> self smush) (lerp-scale (rand-vu-float-range 0.1 0.3) (rand-vu-float-range 0.0 0.02) 50000.0 30720.0 73728.0) 60 60 1.0 1.0))
      (let ((smush (update! (-> self smush))))
        (set-vector! (-> self root scale) (+ (-> self scale x) (/ smush -2)) (+ (-> self scale y) smush) (+ (-> self scale z) (/ smush -2)) 1.0))
      (if (and (= *mode* 'menu) (< (-> self root trans y) (meters -10.0))) (+! (-> self base y) (meters 650.0)))
      (if (and (!= *mode* 'menu) (or (< (-> self offset y) (meters -100.0)) (> (-> self offset y) (meters 100.0)))) (deactivate self))
      (case (-> self look)
        ((7 8) (ja :num! (seek!)))
        ((9 15) (ja :num! (loop!)))
        ((16) (if (ja-group? green-sagecage-green-sagecage-idle-ja) (ja :num! (loop!)) (ja :num! (seek! max 1.3)))))
      (suspend)))
  :post ja-post)

(deftype block-game (process-drawable)
  ((field   int 200)
   (shapes  (inline-array vector))
   (piece   int)
   (next    int)
   (x       int)
   (y       int)
   (level   int)
   (lines   int)
   (extras  int)
   (timeout time-frame)
   (hold    time-frame)
   (gravity float)
   (clock   float)
   (score   int)
   (dry     int)
   (board   float)
   (lost    symbol)
   (moved   symbol)
   (warn    symbol)
   (sync    sync-info :inline))
  (:state-methods idle))

(def-actor block-game
  :bounds (0 0 0 50)
  :art (idle-ja)
  :joints (align prejoint camera))

(defbehavior get-block block-game ((id int))
  (set! (-> *block* id) id)
  (search-process-tree self (lambda ((p process)) (and (= (-> p type) block) (= (-> (the block p) id) (-> *block* id))))))

(defmacro for-block (piece x y &rest body)
  `(let ((id 0))
     (dotimes (times 4)
       (-! id 1)
       (let* ((block-x (mod (the int (-> (-> self shapes ,piece) data times)) 4))
              (block-y (the int (/ (-> (-> self shapes ,piece) data times) 4)))
              (index (+ (* (+ ,y block-y) 10) (+ ,x block-x)))
              (proc (the block (get-block id)))
              (x-loc (* (the float (+ ,x block-x)) (meters 2.0)))
              (y-loc (* (the float (+ ,y block-y)) (meters -2.0)))
              (invalid (and (>= (+ ,y block-y) 0) (or (> (+ ,y block-y) 19) (!= (-> (-> self field) index) -1)))))
          ,@body))))

(defbehavior check block-game ((index int) (step int) (search symbol))
  (let ((id (+ index step)))
    (while (and (or (= step 1) (= step -1) (and (< id 200) (>= id 0)))
                (or (= step -10) (= step 10) (and (<= id (+ (- index (mod index 10)) 9)) (>= id (- index (mod index 10))))))
      (when (or (!= (-> (-> self field) id) -1) (not search))
        (return id))
      (+! id step))
  -100))

(defmacro for-direction (&rest body)
  `(let ((direction 0))
     (dotimes (times 4) (set! direction (case times ((0) -1) ((1) 1) ((2) -10) ((3) 10)))
       ,@body)))

(defbehavior find-around block-game ((index int) (look int))
  (for-direction index
    (if (= (-> (-> self field) (check index direction #f)) look)
      (return #t)))
  #f)

(defbehavior balloon-effect block-game ((index int))
  (let ((search (+ index 10)))
    (while (< search 200)
      (case (-> (-> self field) search) ((7 8 88)
        (send-event (get-block search) 'green (* (/ (the float (- search index)) 10.0) 0.08))
        (when (= (-> (-> self field) search) 7)
          (set! (-> (-> self field) search) 8))))
      (when (and (= (-> (-> self field) search) -1) (or (find-around search 7) (find-around search 8)))
        (process-spawn block (-> self root trans) (* (the float (mod search 10)) (meters 2.0)) (* (the float (/ search 10))
          (meters -2.0)) search 8 (* (/ (the float (- search index)) 10.0) 0.08) :to self)
        (set! (-> (-> self field) search) 88))
      (+! search 10)))
  (none))

(defbehavior shift-down block-game ((id int) (amount int) (delay float) (now symbol))
  (when (get-block id)
    (+! (-> (the block (get-block id)) shift) amount)
    (when (and now (> (-> (the block (get-block id)) shift) 0))
      (send-event (get-block id) 'shift)
      (if (> delay 0.0) (suspend-for (* 1 (* 1.0 delay TICKS_PER_SECOND)))))
    (when (> amount 0)
      (set! (-> (the block (get-block id)) id) (+ id (* 10 amount)))
      (if (<= (+ id (* 10 amount)) 199) (set! (-> (-> self field) (+ id (* 10 amount))) (-> (-> self field) id)))
      (set! (-> (-> self field) id) -1)))
  (none))

(defbehavior cage-effect block-game ()
  (for-block (-> self piece) (-> self x) (-> self y)
    (case times ((2 3)
      (let ((search index))
        (while (!= (-> self field (check search 10 #f)) -1)
          (when (= (check search 10 #f) -100)
            (return #f))
          (+! search 10))))))
  (for-block (-> self piece) (-> self x) (-> self y)
    (case times ((2 3)
      (let ((search index)
            (count 0))
        (while (!= (-> self field (+ search 10)) -1)
          (+! count 1)
          (+! search 10))
        (dotimes (num count)
          (shift-down search 1 0.0 #t)
          (-! search 10))))))
  (none))

(defbehavior move block-game ((piece int) (x int) (y int) (type symbol))
  (if (and (= (-> (the block (get-block -1)) look) 15) (or (= type 'down) (= type 'gravity)))
    (cage-effect))
  (for-block piece x y
    (when (and (or invalid (and (!= type 'rotate) (or (< (+ x block-x) 0) (> (+ x block-x) 9)))) (!= *mode* 'menu))
      (set! (-> self hold) (- (current-time) (seconds 1.0)))
      (return #f))
    (while (< (+ x block-x) 0)
      (+! x 1)
      (for-block piece x y
        (if invalid (return #f))))
    (while (> (+ x block-x) 9)
      (-! x 1)
      (for-block piece x y
        (if invalid (return #f)))))
  (set! (-> self x) x)
  (set! (-> self y) y)
  (set! (-> self piece) piece)
  (when (!= type 'gravity)
    (set! (-> self moved) #t)
    (set! (-> self timeout) (current-time)))
  (when (and (!= *mode* 'menu) (= type 'sideways))
    (if (= (-> (the block (get-block -1)) look) 7) (sound-play "walk-grass2") (sound-play "walk-stone1")))
  (when (and (!= *mode* 'menu) (= type 'rotate))
    (dotimes (count 2) (if (= (-> (the block (get-block -1)) look) 7) (sound-play "land-grass") (sound-play "jump"))))
  (for-block piece x y
    (send-event proc 'set-loc x-loc y-loc)
    (if (and (= (-> proc look) 7) (= type 'rotate)) (send-event proc 'place))
    (when (= (-> proc look) 19)
      (for-direction
        (send-event (get-block (check index direction #t)) 'notice)
        (send-event (get-block (check (check index direction #t) direction #f)) 'notice)))
    (if (and (= (-> proc look) 9) (!= type 'down)) (balloon-effect index)))
  #t)

(defbehavior game-over block-game ()
  (set! (-> self lost) #t)
  (let* ((pc *pc-settings*)
         (value (case *mode* (('normal) (-> pc memcard-01)) (('plant) (-> pc memcard-02)) (('tile) (-> pc memcard-03))))
         (score (/ value 1000))
         (lines (mod value 1000)))
    (if (> (-> self score) score) (set! score (-> self score)))
    (if (> (-> self lines) lines) (set! lines (-> self lines)))
    (set! value (+ (* score 1000) lines))
    (case *mode* (('normal) (set! (-> pc memcard-01) value)) (('plant) (set! (-> pc memcard-02) value)) (('tile) (set! (-> pc memcard-03) value))))
  (commit-to-file *pc-settings*)
  (let ((hint (case (rand-vu-int-range 1 5) ((1) "FIS-AM05") ((2) "FIS-AM06") ((3) "FIS-TA04") ((4) "FIS-TA05") ((5) "FIS-TA07"))))
    (send-event (process-by-name "block-fisher-1" *entity-pool*) 'emote hint))
  (dotimes (id 8)
    (send-event (get-block (- id 8)) 'lose)
    (suspend-for (seconds 0.03)))
  (dotimes (index 200)
    (when (get-block index)
      (send-event (get-block index) 'lose)
      (suspend-for (seconds 0.05))))
  (none))

(defbehavior warn block-game ()
  (let ((highest 199))
    (dotimes (count 200) (if (!= (-> (-> self field) (- 199 count)) -1) (set! highest (- 199 count))))
    (when (and (< highest 50) (not (-> self warn)))
      (set! (-> self warn) #t)
      (send-event (process-by-name "block-fisher-1" *entity-pool*) 'emote (if (rand-vu-percent? 0.5) "FIS-TA06" "FIS-TA11")))
    (if (> highest 50) (set! (-> self warn) #f)))
  (none))

(defbehavior encourage block-game ()
  (dotimes (row 20)
    (let ((count-x 0)
          (above 0)
          (gap -1)
          (y (* (- 19 row) 10)))
      (dotimes (x 10) (if (!= (-> (-> self field) (+ y x)) -1) (+! count-x 1) (set! gap x)))
      (when (= count-x 9)
        (dotimes (above-row 3)
          (dotimes (x 10) (if (= (-> (-> self field) (- (+ y x) (* (+ 1 above-row) 10))) -1) (+! above 1))))
        (when (and (= above 3) (!= (-> (-> self field) (+ y gap 10)) -1) (= (check (+ y gap) -10 #t) -100))
          (let ((hint ""))
            (when (<= gap 4) (set! hint (if (rand-vu-percent? 0.5) "FIS-TA01" "FIS-TA1A")))
            (when (> gap 4) (set! hint (if (rand-vu-percent? 0.5) "FIS-TA02" "FIS-TA2A")))
            (when (rand-vu-percent? 0.7) (set! hint "FIS-TA03"))
            (send-event (process-by-name "block-fisher-1" *entity-pool*) 'emote hint))
          (return #f)))))
  (none))

(defbehavior new-piece block-game ()
  (set! (-> self clock) 0.0)
  (if (and (= *mode* 'normal) (= (/ (the-as int (-> self next)) 4) 1)) (encourage))
  (set! (-> self piece) (-> self next))
  (set! (-> self next) (* (rand-vu-int-range 0 6) 4))
  (set! (-> self x) 3)
  (set! (-> self y) -2)
  (when (not (move (-> self piece) (-> self x) (-> self y) #f))
    (game-over)
    (return #f))
  (for-block (-> self piece) 3 -2
    (set! proc (the block (get-block (- id 4))))
    (send-event proc 'set-loc x-loc y-loc)
    (set! (-> proc id) id))
  (move (-> self piece) (-> self x) (-> self y) #f)
  (let ((look (-> (the block (get-block -1)) look))
        (next -1))
    (case look
      ((9) (set! (-> self gravity) 0.8) (beam-color 0.0 0.0 64.0))
      ((17) (beam-color 128.0 0.0 0.0))
      ((18) (sound-play "get-yellow-eco") (beam-color 32.0 32.0 0.0))
      ((19) (sound-play "get-blue-eco") (beam-color 0.0 80.0 255.0)))
    (if (= *mode* 'tile) (set! next (if (or (rand-vu-percent? 0.04) (>= (-> self dry) 20)) 15 -1)))
    (if (= *mode* 'plant) (set! next (if (rand-vu-percent? 0.004) 9 (if (and (= look 7) (or (rand-vu-percent? 0.2) (>= (-> self dry) 5))) 20 7))))
    (if (= *mode* 'normal) (set! next (if (rand-vu-percent? 0.01) (rand-vu-int-range 17 19) (/ (the-as int (-> self next)) 4))))
    (case next ((15) (set! (-> self next) 0) (set! (-> self dry) 0)) ((20) (set! (-> self dry) 0)) (else (+! (-> self dry) 1)))
    (let ((colors (new 'stack-no-clear 'vector)))
      (dotimes (count 4) (set! (-> colors data count) (the float (rand-vu-int-range 10 14))))
      (for-block (-> self next) 11 2
        (if (and (= *mode* 'tile) (!= next 15) (!= next 16)) (set! next (the int (-> colors data (rand-vu-int-range 0 3)))))
        (if (and (= next 15) (= times 1)) (set! next 16))
        (when (or (< times 2) (and (!= next 15) (!= next 16)))
          (process-spawn block (-> self root trans) x-loc y-loc (- id 4) next 0.0 :to self)))))
  (none))

(defbehavior move-field block-game ()
  (vector-copy! (-> (the process-drawable (process-by-name "block-cam-1" *entity-pool*)) root trans) (-> self root trans))
  (when (= *mode* 'normal)
    (vector-copy! (-> (the block-fisher (process-by-name "block-fisher-1" *entity-pool*)) base) (-> self root trans))
    (vector-copy! (-> (the block-fisher (process-by-name "block-fisher-2" *entity-pool*)) base) (-> self root trans)))
  (send-event *camera* 'teleport-to-transformq (-> self root trans))
  (dotimes (index 200) (if (get-block index) (vector-copy! (-> (the block (get-block index)) base) (-> self root trans))))
  (for-block (-> self piece) 3 -2
    (if proc (vector-copy! (-> proc base) (-> self root trans))))
  (dotimes (count 4) (if (get-block (- count 8)) (vector-copy! (-> (the block (get-block (- count 8))) base) (-> self root trans))))
  (none))

(defbehavior clear-level-actors block-game ()
  (dotimes (count 21)
    (let ((actor (entity-by-name (case count
      ((0) "crate-11") ((1) "crate-12") ((2) "crate-230") ((3) "crate-921") ((4) "crate-922")
      ((5) "crate-924") ((6) "crate-2315") ((7) "crate-2321") ((8) "crate-2336")
      ((9) "crate-2337") ((10) "crate-3211") ((11) "snow-bunny-64") ((12) "money-2233")
      ((13) "babak-277") ((14) "babak-276") ((15) "steam-cap-4") ((16) "crate-darkeco-cluster-6")
      ((17) "happy-plant-1") ((18) "red-sagecage-1") ((19) "orbit-plat-1") ((20) "orbit-plat-3")))))
    (when actor
      (logior! (-> actor extra perm status) (entity-perm-status dead complete))
      (if (-> actor extra process) (deactivate (-> actor extra process))))))
  (none))

(defbehavior load-level block-game ((wanted symbol) (extra symbol) (loc vector) (show symbol))
  (when show 
    (load-state-want-display-level wanted 'display)
    (load-state-want-force-vis wanted #t))
  (when (and (not show) (not (vector= (-> self root trans) loc)))
    (vector-copy! (-> self root trans) loc)
    (load-state-want-levels wanted extra)
    (set-force-inside! *load-state* wanted #t)
    (move-field)
    (if (!= (-> self lines) 0) (dotimes (count 2) (sound-play "menu-stats")))
    (play-main-music (string-format "~S.wav" wanted) (the int (* (-> *setting-control* default music-volume) 1.25))))
  (none))

(defbehavior set-level block-game ((show symbol))
  (when (= *mode* 'normal)
    (case (mod (the int (/ (-> self lines) 10)) 10)
      ((0 1) (load-level 'beach 'jungle (static-vectorm -198 40 -285) show))
      ((2 3) (load-level 'jungle 'firecanyon (static-vectorm 261 75 -266) show))
      ((4 5) (load-level 'firecanyon 'sunken (static-vectorm 135 69 -480) show))
      ((6 7) (load-level 'sunken 'snow (static-vectorm 840 -103 -1628) show))
      ((8 9) (load-level 'snow 'beach (static-vectorm 655 295 -3330) show)))
    (if (not show) (set-time-of-day (if (>= (mod (-> self lines) 200) 100) 23.0 9.0))))
  (none))

(defbehavior break-block block-game ((index int) (delay float) (sound symbol) (extra symbol))
  (if extra (+! (-> self extras) 1))
  (set! (-> (-> self field) index) -1)
  (when (and sound (or (and extra (= (mod (-> self extras) 3) 1)) (and (not extra) (= (mod (mod index 10) 3) 0))))
    (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 70 (seconds 0.15))
    (if (= *mode* 'plant) (sound-play "pill-pickup") (sound-play "icrate-break")))
  (send-event (get-block index) 'break)
  (suspend-for (* 1 (* 1.0 delay TICKS_PER_SECOND)))
  (none))

(defbehavior red-effect block-game ()
  (sound-play "get-red-eco")
  (dotimes (count 200)
    (let ((search (- 199 count)))
      (while (= (-> self field (check search 10 #f)) -1)
        (shift-down search 1 0.0 #f)
        (+! search 10))))
  (dotimes (count 200) (shift-down (- 199 count) 0 0.017 #t))
  (none))

(defbehavior set-plant block-game ((index int) (before int) (after int))
  (for-direction
    (when (= (-> (-> self field) (check index direction #f)) before)
      (send-event (get-block (check index direction #f)) 'green 0.0)
      (set! (-> (-> self field) (check index direction #f)) after)))
  (none))

(defbehavior green-effect block-game ()
  (dotimes (index 200)
    (when (= (-> (-> self field) index) 20)
      (set-plant index 7 77)
      (set-plant index 8 88)))
  (dotimes (times 200)
    (let ((grew #f))
      (dotimes (index 200)
        (when (= (-> (-> self field) index) 88)
          (set! (-> (-> self field) index) 888)
          (set! grew #t))
        (when (= (-> (-> self field) index) 77)
          (set! (-> (-> self field) index) 88)
          (set! grew #t)))
      (when grew
        (if (= (mod times 4) 0) (sound-play "darkvine-move"))
        (sound-play "pill-pickup")
        (suspend-for (seconds 0.03)))
      (dotimes (index 200)
        (when (= (-> (-> self field) index) 777)
          (set-plant index 8 88))
        (when (= (-> (-> self field) index) 888)
          (set-plant index 7 777)
          (set-plant index 8 88)))))
  (dotimes (index 200)
    (case (-> (-> self field) index) ((777 888)
      (set! (-> (-> self field) index) 8))))
  (none))

(defbehavior purple-grow block-game ()
  (let ((chance (rand-vu-int-range 1 (the int (* 1.2 (-> *display* frames-per-second)))))
        (index (rand-vu-int-range 0 199)))
    (when (and (= chance 1) (= (-> (-> self field) index) 8) (find-around index 7))
      (send-event (get-block index) 'purple #t)
      (set! (-> (-> self field) index) 7)))
  (none))

(defbehavior yellow-effect block-game ()
  (let ((clears 0))
    (dotimes (row 20)
      (let ((y (* (- 19 row) 10))
            (leftmost 200)
            (rightmost -1))
        (dotimes (x 10)
          (when (= (-> (-> self field) (+ y x)) 18)
            (if (< (+ y x) leftmost) (set! leftmost (+ y x)))
            (if (> (+ y x) rightmost) (set! rightmost (+ y x)))))
        (when (or (!= leftmost 200) (!= rightmost -1))
          (+! clears 1)
          (if (> (mod leftmost 10) 0) (send-event (get-block leftmost) 'shoot-left))
          (if (< (mod rightmost 10) 9) (send-event (get-block rightmost) 'shoot-right))
          (while (!= (check leftmost -1 #t) -100)
            (break-block (check leftmost -1 #t) 0.017 #t #t))
          (while (!= (check rightmost 1 #t) -100)
            (break-block (check rightmost 1 #t) 0.017 #t #t)))
        (dotimes (x 10) (if (= (-> (-> self field) (+ y x)) 18) (break-block (+ y x) 0.0 #f #f)))
        (when (and (= leftmost 200) (= rightmost -1))
          (dotimes (x 10) (shift-down (+ y x) clears 0.0 #f))))))
  (none))

(defbehavior award-score block-game ((clears int))
  (+! (-> self lines) clears)
  (if (< (-> self level) (the int (/ (-> self lines) 10))) (set! (-> self level) (the int (/ (-> self lines) 10))))
  (set! (-> self gravity) (* 0.8 (exp (* -0.1589 (-> self level)))))
  (set! clears (+ (* clears 10) (-> self extras)))
  (let ((fraction (cond ((= *mode* 'tile) 10) ((>= clears 40) 30) ((>= clears 30) 10) ((>= clears 20) 5) (else 4))))
    (+! (-> self score) (* (* fraction clears) (+ (-> self level) 1)))
    (set! (-> self extras) 0))
  (none))

(defbehavior tile-effect block-game ()
  (dotimes (index 200)
    (let ((count 0)
          (current (-> (-> self field) index)))
      (case current ((10 11 12 13 14)
        (+! (-> (-> self field) index) 100)
        (dotimes (number 200)
          (dotimes (id 200)
            (when (= (-> (-> self field) id) (+ current 100))
              (for-direction
                (when (= (-> (-> self field) (check id direction #f)) current)
                  (+! count 1)
                  (+! (-> (-> self field) (check id direction #f)) 100))))))))
      (when (>= count 4)
        (case current ((10) (beam-color 128.0 32.0 0.0)) ((11) (beam-color 128.0 0.0 0.0))
          ((12) (beam-color 0.0 64.0 0.0)) ((13) (beam-color 0.0 80.0 255.0)) ((14) (beam-color 128.0 128.0 0.0)))
        (dotimes (id 200) (if (= (-> (-> self field) id) (+ current 100)) (set! (-> (the block (get-block id)) clock) 1.0)))
        (suspend-for (seconds 0.7))
        (sound-play "bridge-piece-dn")
        (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 70 (seconds 0.35))
        (award-score 1)
        (dotimes (id 200)
          (case (-> (-> self field) (- 199 id)) ((current (+ current 100))
            (break-block (- 199 id) 0.017 #f #f)))))
      (dotimes (id 200) (if (> (-> (-> self field) id) 100) (-! (-> (-> self field) id) 100)))))
  (beam-color 64.0 64.0 64.0)
  (none))

(defbehavior place-sound block-game ((look int))
  (let ((sound (case look ((0) "land-pcmetal") ((1) "walk-metal2") ((2) "land-metal") ((3) "land-wood")
    ((4) "walk-wood1") ((5) "walk-wood2") ((6) "walk-pcmetal1"))))
    (dotimes (count 3) (sound-play-by-name (string->sound-name sound) (new-sound-id) 1024 0 0 (sound-group sfx) #f)))
  (if (= look 7) (dotimes (count 2) (sound-play "land-grass")))
  (case look
    ((17 18 19) (send-event (process-by-name "block-fisher-1" *entity-pool*) 'emote (if (rand-vu-percent? 0.5) "FIS-LO03" "FIS-LO05"))))
  (none))

(defbehavior end-turn block-game ((look int))
  (dotimes (index 200) (if (= (-> (-> self field) index) 88) (set! (-> (-> self field) index) 8)))
  (for-block (-> self piece) (-> self x) (-> self y)
    (when (and (>= index 0) (!= look 9))
      (set! (-> (-> self field) index) (if (= look 15) 15 (-> proc look)))
      (set! (-> proc id) index)
      (send-event proc 'place))
    (if (or (< index 0) (= look 9)) (send-event proc 'break)))
  (place-sound look)
  (case look ((17) (red-effect)) ((18) (yellow-effect)) ((20) (green-effect)))
  (if (= *mode* 'tile) (tile-effect))
  (let ((clears 0))
    (when (and (!= look 18) (!= *mode* 'tile))
      (dotimes (row 20)
        (let ((count-x 0)
              (y (* (- 19 row) 10)))
          (dotimes (x 10) (case (-> (-> self field) (+ y x)) ((-1 7)) (else (+! count-x 1))))
          (when (= count-x 10)
            (if (= *mode* 'plant) (beam-color 0.0 64.0 0.0))
            (+! clears 1)
            (dotimes (x 10) (break-block (+ y x) 0.03 #t #f)))
          (when (< count-x 10)
            (dotimes (x 10) (shift-down (+ y x) clears 0.0 #f)))))
      (dotimes (count 200)
        (when (and (get-block (- 199 count)) (= (-> (the block (get-block (- 199 count))) notice) #t))
          (break-block (- 199 count) 0.03 #t #t))))
    (award-score clears)
    (set-level #t))
  (dotimes (index 200) (shift-down (- 199 index) 0 0.017 #t))
  (set-level #f)
  (case *mode* (('plant) (beam-color 35.0 0.0 128.0)) (('normal) (beam-color 0.0 0.0 128.0)))
  (dotimes (index 200)
    (case (-> (-> self field) index) ((9 15 16 17 18 19 20)
      (break-block index 0.0 #f #f))))
  (if (= *mode* 'normal) (warn))
  (new-piece)
  (none))

(defbehavior common-init block-game ((this block-game))
  (set! (-> this root) (new 'process 'trsqv))
  (set! (-> this level) (the int (the-as float (-> *progress-carousell* int-backup))))
  (dotimes (index 200) (set! (-> this field index) -1))
  (set! (-> this shapes) (new 'static 'inline-array vector 28
    (static-vector 9.0 10.0 13.0 14.0) (static-vector 10.0 14.0 9.0 13.0) (static-vector 14.0 13.0 10.0 9.0) (static-vector 13.0 9.0 14.0 10.0)
    (static-vector 8.0 9.0 10.0 11.0) (static-vector 2.0 6.0 10.0 14.0) (static-vector 11.0 10.0 9.0 8.0) (static-vector 14.0 10.0 6.0 2.0)
    (static-vector 9.0 10.0 11.0 15.0) (static-vector 6.0 10.0 14.0 13.0) (static-vector 11.0 10.0 9.0 5.0) (static-vector 14.0 10.0 6.0 7.0)
    (static-vector 11.0 10.0 9.0 13.0) (static-vector 14.0 10.0 6.0 5.0) (static-vector 9.0 10.0 11.0 7.0) (static-vector 6.0 10.0 14.0 15.0)
    (static-vector 13.0 14.0 10.0 11.0) (static-vector 6.0 10.0 11.0 15.0) (static-vector 11.0 10.0 14.0 13.0) (static-vector 15.0 11.0 10.0 6.0)
    (static-vector 9.0 10.0 11.0 14.0) (static-vector 6.0 10.0 14.0 9.0) (static-vector 11.0 10.0 9.0 6.0) (static-vector 14.0 10.0 6.0 11.0)
    (static-vector 9.0 10.0 14.0 15.0) (static-vector 7.0 11.0 10.0 14.0) (static-vector 15.0 14.0 10.0 9.0) (static-vector 14.0 10.0 11.0 7.0)))
  (when (!= *mode* 'menu)
    (process-spawn block-cam :init pov-camera-init-by-other (-> self root trans) *block-game-sg* "idle" 0 self '() :name "block-cam-1" :to *entity-pool*)
    (send-event (process-by-name "block-cam-1" *entity-pool*) 'mask 0)
    (set! (-> *time-of-day-proc* 0 time-ratio) 0.0)
    (award-score 0))
  (none))

(defbehavior block-game-init-by-other block-game ()
  (stack-size-set! (-> self main-thread) 1024)
  (set! *mode* #f)
  (common-init self)
  (when (name= (-> *game-info* current-continue name) 'beach-start)
    (set! *mode* 'normal)
    (beam-color 0.0 0.0 128.0)
    (make-light-kit (-> *sunken-mood* light-group 1) (degrees 45) 1.0 1.0 0.5)
    (set! (-> *game-info* current-continue level) #f)
    (process-spawn block-fisher #f :name "block-fisher-1" :to *entity-pool*)
    (process-spawn block-fisher #t :name "block-fisher-2" :to *entity-pool*)
    (load-params! (-> self sync) self (the-as uint 140) 0.0 0.15 0.15)
    (set-level #f))
  (when (name= (-> *game-info* current-continue name) 'rolling-start)
    (set! *mode* 'plant)
    (beam-color 35.0 0.0 128.0)
    (set-time-of-day 9.0)
    (close-specific-task! (game-task rolling-plants) (task-status need-resolution))
    (load-level 'rolling #f (static-vectorm -348 64 -1656) #f)
    (set! (-> (-> *rolling-mood-fog-table* data 1) fog-end) (meters 500))
    (set! (-> (-> *rolling-mood-fog-table* data 1) fog-start) (meters 85))
    (vector-copy! (-> (-> *rolling-mood-fog-table* data 1) fog-color) (static-vector 255.0 255.0 255.0 128.0))
    (set! (-> self sound) (new 'process 'ambient-sound (static-sound-spec "waterfall" :volume 0 :fo-max 5000) (-> self root trans))))
  (when (name= (-> *game-info* current-continue name) 'citadel-start)
    (set! *mode* 'tile)
    (make-light-kit (-> *citadel-mood* light-group 1) (degrees 45) 1.0 1.0 0.5)
    (set! (-> *part-id-table* 2473 init-specs 4 initial-valuef) (meters 3.0))
    (load-level 'citadel #f (static-vectorm 2845 9 -4713) #f))
  (go (method-of-object self idle))
  (none))

(defmethod init-from-entity! ((this block-game) (arg0 entity-actor))
  (set! *mode* 'menu)
  (common-init this)
  (set! (-> this gravity) (rand-vu-float-range 0.1 0.6))
  (process-drawable-from-entity! this arg0)
  (go (method-of-object this idle))
  (none))

(defbehavior draw-line block-game ((loc vector) (pos vector))
  (let ((start (new-stack-vector0))
        (end (new-stack-vector0)))
    (set-vector! start (+ (-> loc x) (* (-> pos x) (meters 0.975))) (+ (-> loc y) (* (-> pos y) (meters 0.975))) (-> loc z) 1.0)
    (set-vector! end (+ (-> loc x) (* (-> pos z) (meters 0.975))) (+ (-> loc y) (* (-> pos w) (meters 0.975))) (-> loc z) 1.0)
    (draw-eco-beam start end))
  (none))

(defbehavior draw-digit block-game ((loc vector) (value int))
  (dotimes (count 7)
    (let ((bit (case value ((0) 119) ((1) 18) ((2) 93) ((3) 91) ((4) 58) ((5) 107) ((6) 111) ((7) 82) ((8) 127) ((9) 122)))
          (seg (case count ((0) (static-vector 1.0 0.0 0.0 0.0)) ((1) (static-vector 1.0 0.0 1.0 1.0))
          ((2) (static-vector 0.0 0.0 0.0 1.0)) ((3) (static-vector 1.0 1.0 0.0 1.0)) ((4) (static-vector 1.0 1.0 1.0 2.0))
          ((5) (static-vector 0.0 1.0 0.0 2.0)) ((6) (static-vector 1.0 2.0 0.0 2.0)))))
      (if (nonzero? (logand bit (ash 1 count))) (draw-line loc seg))))
  (none))

(defbehavior draw-score block-game ((loc vector) (score float) (start int))
  (let ((trans (new-stack-vector0))
        (digit 1000000))
    (vector-copy! trans loc)
    (dotimes (count 7)
      (when (>= count start)
        (set! (-> trans x) (the-as float (+ (-> loc x) (* count (meters 1.7)))))
        (draw-digit trans (mod (the int (/ score digit)) 10)))
      (set! digit (the int (/ digit 10)))))
  (none))

(defbehavior hold-button block-game ((button int) )
  (if (logtest? (cpad-pressed 0) button) (set! (-> self hold) (current-time)))
  (if (or (logtest? (cpad-pressed 0) button)
          (and (logtest? (cpad-hold 0) button)
               (time-elapsed? (-> self timeout) (seconds 0.03))
               (time-elapsed? (-> self hold) (seconds 0.12))))
    #t #f))

(defbehavior attempt-move block-game ()
  (cond
   ((hold-button (ash 1 7)) (move (-> self piece) (- (-> self x) 1) (-> self y) 'sideways))
   ((hold-button (ash 1 5)) (move (-> self piece) (+ (-> self x) 1) (-> self y) 'sideways)))
  (when (and (hold-button (ash 1 6)) (move (-> self piece) (-> self x) (+ (-> self y) 1) 'down))
    (set! (-> self clock) 0.0)
    (+! (-> self score) 1))
  (when (and (cpad-pressed? 0 up) (!= *mode* 'menu))
    (while (move (-> self piece) (-> self x) (+ (-> self y) 1) 'down) (+! (-> self score) 2))
    (suspend-for (seconds 0.15))
    (end-turn (-> (the block (get-block -1)) look)))
  (when (cpad-pressed? 0 circle)
    (case (-> (the block (get-block -1)) look)
      ((15) (send-event (the block (get-block -1)) 'spin 90.0) (send-event (the block (get-block -2)) 'spin 90.0))
      (else (move (if (= (mod (-> self piece) 4) 3) (- (-> self piece) 3) (+ (-> self piece) 1)) (-> self x) (-> self y) 'rotate))))
  (when (cpad-pressed? 0 x)
    (case (-> (the block (get-block -1)) look)
      ((15) (send-event (the block (get-block -1)) 'spin -90.0) (send-event (the block (get-block -2)) 'spin -90.0))
      (else (move (if (= (mod (-> self piece) 4) 0) (+ (-> self piece) 3) (- (-> self piece) 1)) (-> self x) (-> self y) 'rotate))))
  (none))

(defbehavior rain block-game ()
  (let ((balloon (= (-> (the block (get-block -1)) look) 9))
        (volume (the float (-> (-> self sound) volume))))
    (update! (-> self sound))
    (set! (-> (-> self sound) volume) (the int (lerp volume (if balloon 1000.0 0.0) (* 0.04 DISPLAY_FPS_RATIO))))
    (when balloon
      (launch-particles (-> *part-id-table* 37) (static-vectorm -339 45 -1640))
      (launch-particles (-> *part-id-table* 38) (static-vectorm -339 45 -1640)))
    (cond
      ((and balloon (> (-> *time-of-day-proc* 0 time-of-day) 8.2)) (set! (-> *time-of-day-proc* 0 time-ratio) -50000.0))
      ((and (not balloon) (< (-> *time-of-day-proc* 0 time-of-day) 9.0)) (set! (-> *time-of-day-proc* 0 time-ratio) 50000.0))
      (else (set! (-> *time-of-day-proc* 0 time-ratio) 0.0))))
  (none))

(defstate idle (block-game)
  :virtual #t
  :enter (behavior ()
    (set! (-> self next) (* (rand-vu-int-range 0 6) 4))
    (set! (-> self piece) (-> self next))
    (let ((colors (new 'stack-no-clear 'vector)))
      (dotimes (count 4) (set! (-> colors data count) (the float (rand-vu-int-range 10 14))))
      (for-block (-> self piece) 3 -2
        (let ((look -1))
          (case *mode*
            (('tile) (set! look (the int (-> colors data (rand-vu-int-range 0 3)))))
            (('plant) (set! look 7))
            (else (set! look (/ (the-as int (-> self piece)) 4))))
          (process-spawn block (-> self root trans) x-loc y-loc id look 0.0 :to self))))
    (set! (-> self dry) 1)
    (when (!= *mode* 'menu)
      (stop 'play)
      (new-piece)))
  :trans (behavior ()
    (if (!= (-> self lost) #t) (+! (-> self clock) (seconds-per-frame)))
    (when (!= *mode* 'menu)
      (set! *teleport* #t)
      (clear-level-actors)
      (if (= *mode* 'plant) (rain))
      (if (cpad-pressed? 0 select) (set! *hide* (if *hide* #f #t)))
      (when (and (level-get *level* 'snow) (-> (level-get *level* 'snow) display?))
        (launch-particles (-> *part-id-table* 33) (static-vectorm 664 277 -3300)))
      (when (and (= (-> self warn) #t) (!= (-> self lost) #t))
        (if (< (get-current-phase (-> self sync)) 0.5) (beam-color 128.0 0.0 0.0) (beam-color 0.0 0.0 128.0)))
      (when (time-elapsed? (-> self state-time) (seconds 0.017))
        (let ((pos (new-stack-vector0))
              (end (new-stack-vector0)))
          (set-state-time)
          (vector+! pos (-> self root trans) (static-vectorm 19.8 -4.25 0))
          (if (>= (-> self score) 1000000) (+! (-> pos x) (meters 1.0)))
          (set! (-> self board) (lerp (-> self board) (the float (-> self score)) (* 0.2 DISPLAY_FPS_RATIO)))
          (draw-score pos (+ (-> self board) 0.1) (if (>= (-> self score) 1000000) 0 1))
          (vector+! pos (-> self root trans) (static-vectorm 19.8 -1 0))
          (draw-score pos (the float (-> self lines)) 4)
          (vector+! pos (-> self root trans) (static-vectorm -15.2 -1 0))
          (draw-score pos (the float (-> self level)) 5)
          (vector+! pos (-> self root trans) (static-vectorm -1.4 2 0))
          (vector+! end (-> self root trans) (static-vectorm -1.4 -38 0))
          (draw-eco-beam pos end)
          (vector+! pos (-> self root trans) (static-vectorm 19.4 2 0))
          (vector+! end (-> self root trans) (static-vectorm 19.4 -38 0))
          (draw-eco-beam pos end)))))
  :code (behavior ()
    (loop
      (when (!= (-> self lost) #t)
        (if (= *mode* 'plant) (purple-grow))
        (set! (-> self moved) #f)
        (dotimes (count (+ (the int (/ (-> self clock) (-> self gravity))) 1))
          (if (not (-> self moved)) (attempt-move))
          (when (>= (-> self clock) (-> self gravity))
            (when (not (move (-> self piece) (-> self x) (+ (-> self y) 1) 'gravity))
              (end-turn (-> (the block (get-block -1)) look)))
            (set! (-> self clock) (max 0.0 (- (-> self clock) (-> self gravity)))))))
      (when (= *mode* 'menu)
        (let ((action (rand-vu-int-range 1 (* 2 (-> *display* frames-per-second)))))
          (case action
            ((1) (move (if (= (mod (-> self piece) 4) 0) (+ (-> self piece) 3) (- (-> self piece) 1)) (-> self x) (-> self y) #t))
            ((15) (move (-> self piece) (- (-> self x) (rand-vu-int-range 1 2)) (-> self y) 'rotate))
            ((30) (move (-> self piece) (+ (-> self x) (rand-vu-int-range 1 2)) (-> self y) 'rotate)))))
      (suspend))))

(defun spawn-block-game () (process-spawn block-game :name "block-game-1" :to *entity-pool*) (none))